# Required for real model runs. Never place this file in a target repository snapshot.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional verified pricing, in USD per million tokens. If unset, cost is reported as null.
CODEREPAIR_INPUT_COST_PER_MILLION=
CODEREPAIR_OUTPUT_COST_PER_MILLION=

# Build docker/test-runner.Dockerfile with this tag before test-enabled runs.
CODEREPAIR_TEST_IMAGE=coderepair-sandbox:py311

